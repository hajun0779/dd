# 디스코드 봇 토큰 (필수)
# config.js 맨 위의 BOT_TOKEN 에 직접 넣어도 됩니다. 이 값이 있으면 이쪽이 우선합니다.
DISCORD_TOKEN=

# 아래 값들은 비워두면 config.js 의 기본값(요청받은 ID)이 사용됩니다.

# 티켓 패널이 게시될 채널
TICKET_PANEL_CHANNEL_ID=1535140042652254219
# 티켓을 열람할 수 있는 스태프 역할
TICKET_STAFF_ROLE_ID=1535140290581635162
# 티켓 종료 시 HTML 기록이 전송될 채널
TICKET_TRANSCRIPT_CHANNEL_ID=1535140618626670623
# 티켓 채널이 생성될 카테고리
TICKET_CATEGORY_ID=1535141065160658944

# 패널 안에 배너 이미지를 넣고 싶을 때 (비워 두면 이미지 없이 나갑니다)
TICKET_PANEL_IMAGE_URL=

# 선택 사항
# 티켓 종료 후 채널 삭제까지 대기 시간(초)
TICKET_DELETE_DELAY_SECONDS=5
# 기록에 담을 최대 메시지 수
TRANSCRIPT_MAX_MESSAGES=5000
# 데이터 저장 경로
DATA_FILE=
