# 디스코드 봇 토큰 (필수)
# config.js 맨 위의 BOT_TOKEN 에 직접 넣어도 됩니다. 이 값이 있으면 이쪽이 우선합니다.
DISCORD_TOKEN=

# 컨테이너 맨 아래 작은 글씨에 들어갈 이름과 저작권 문구
BRAND_NAME=RoStation
COPYRIGHT_YEAR=2026
# 직접 다 적고 싶으면 아래를 채우세요. 비우면 "Copyright 2026. RoStation. All rights reserved." 가 됩니다.
COPYRIGHT_TEXT=

# 총관리자 역할
# 모든 명령을 쓸 수 있고, 기간 조정과 지급 완료 버튼을 누를 수 있으며, 모든 보고를 DM 으로 받습니다.
ADMIN_ROLE_ID=

# 봇이 설정, 제품 zip, 배당, 급여 기록을 보관할 채널 (스태프만 보이게 만들어 주세요)
STORAGE_CHANNEL_ID=

# 직원 명단이 계속 올라가 있을 채널과 갱신 주기(분). 최소 5분입니다.
STAFF_LIST_CHANNEL_ID=1535253952197697536
STAFF_LIST_REFRESH_MINUTES=60

# --- 환영 ---
# 서버에 들어온 사람을 맞이할 채널. 비우면 환영 메시지를 올리지 않습니다.
WELCOME_CHANNEL_ID=1535519323916083244
# 컨테이너 안에 들어갈 그림 주소.
# 봇이 켜질 때 한 번 받아서 보관 채널에 옮겨 두므로, 주소가 만료돼도 계속 나옵니다.
# 그림을 바꾸려면 새 주소를 넣고 보관 채널의 welcome.png 메시지를 지운 뒤 봇을 다시 켜세요.
WELCOME_IMAGE_URL=
# 비우면 아래 기본 문구가 나갑니다.
# 제목: 개발1번출구, 로스테이션으로 오신걸 환영합니다.
WELCOME_TITLE=
# 설명: 로스테이션에 {user}님이 승차하셨습니다.  ({user} 자리에 들어온 사람 멘션이 들어갑니다)
WELCOME_DESCRIPTION=
# 봇이 들어왔을 때는 맞이하지 않습니다. 봇도 맞이하려면 false 로 바꾸세요.
WELCOME_SKIP_BOTS=true

# --- 초대 ---
# /초대코드 로 만드는 초대가 가리킬 채널.
# 비우면 환영 채널을, 그것도 없으면 명령을 쓴 채널을 씁니다.
# 만들어지는 초대는 기간 무제한, 횟수 무제한입니다.
INVITE_CHANNEL_ID=
# 누가 누구 초대로 들어왔는지 올라갈 채널.
# 비우면 코드를 만든 사람에게 DM 으로만 갑니다.
INVITE_LOG_CHANNEL_ID=

# --- 문의 ---
# 문의 패널이 게시될 채널
TICKET_PANEL_CHANNEL_ID=1535140042652254219
# 문의를 열람할 수 있는 스태프 역할
TICKET_STAFF_ROLE_ID=1535140290581635162
# 문의를 닫을 때 HTML 기록이 올라갈 채널
TICKET_TRANSCRIPT_CHANNEL_ID=1535140618626670623

# 문의 종류마다 카테고리를 따로 씁니다.
# 제품 문의와 파트너 문의 카테고리 ID 를 비워 두면 통합 문의 카테고리를 같이 씁니다.
TICKET_CATEGORY_GENERAL=1535141065160658944
TICKET_CATEGORY_PRODUCT=
TICKET_CATEGORY_PARTNER=

# 한국 시간 보정값(시간). 서머타임이 없어 9로 고정입니다.
# Node 가 전체 ICU 없이 설치된 곳에서도 어긋나지 않도록 직접 더해서 씁니다.
TIMEZONE_OFFSET_HOURS=9

# 문의 받는 시간 (한국 시간 기준)
# 이 시간 안에 올라온 문의만 스태프 역할을 부릅니다.
BUSINESS_START_HOUR=11
BUSINESS_END_HOUR=18
# 0=일 1=월 2=화 3=수 4=목 5=금 6=토
BUSINESS_DAYS=1,2,3,4,5

# --- 후기와 제품 ---
# 후기가 올라갈 채널
REVIEW_CHANNEL_ID=
# 제품을 등록하고 보낼 수 있는 역할
PRODUCT_APPROVAL_ROLE_ID=

# --- 명령어 사용 권한 ---
# 명령마다 쓸 수 있는 역할을 정합니다. 비우면 기본값을 씁니다.
#   기본값: 초대코드, 초대랭킹은 누구나 / 송금요청은 총관리자만 / 나머지는 서버 관리 권한
# 형식: 명령이름:역할ID   여러 명령은 쉼표, 한 명령에 역할 여러 개는 슬래시로 나눕니다.
#   COMMAND_ROLES=송금요청:1111,배당:2222/3333
# 역할을 정한 명령은 그 역할만 있으면 서버 관리 권한이 없어도 쓸 수 있습니다.
# 서버 관리자와 총관리자 역할은 언제나 모든 명령을 쓸 수 있습니다.
COMMAND_ROLES=

# --- 송금 ---
# /송금요청 안내에 들어갈 계좌
PAYMENT_BANK=케이뱅크
PAYMENT_ACCOUNT=888002809240
PAYMENT_HOLDER=ㅈㅎㅈ
# 송금 확인과 미확인 기록이 올라갈 채널
PAYMENT_LOG_CHANNEL_ID=

# --- A/S ---
# 제작이 끝나고 전달이 끝난 뒤 몇 시간 안에 수리를 맡길 수 있는지
REPAIR_HOURS=24
# 무상 수리 횟수 (인당)
REPAIR_FREE_COUNT=2

# --- 업무 배당 ---
# 고를 수 있는 분야 목록. 쉼표로 적습니다. (최대 25개)
# 비우면 config.js 의 기본 목록을 씁니다.
WORK_FIELDS=Scripter,Builder,Graphic,Modeler,Animator,Programmer,Clothing,GUI,Sound,VFX

# 배당하면 목록이 올라갈 채널
ASSIGN_LIST_CHANNEL_ID=
# 수락, 거절, 보고, 기간 조정, 연장, 기간 지남이 올라갈 채널
ASSIGN_STATUS_CHANNEL_ID=
# 직원 경고 상태판이 있을 채널
WARNING_CHANNEL_ID=
# 급여 신청이 올라갈 채널
PAYROLL_CHANNEL_ID=

# 기간이 지난 뒤 몇 시간마다 알릴지
OVERDUE_NOTICE_HOURS=1
# 연장을 누르면 몇 시간을 더 줄지
EXTEND_HOURS=2

# --- 그 밖에 ---
# 패널 안에 배너 이미지를 넣고 싶을 때 (비워 두면 이미지 없이 나갑니다)
TICKET_PANEL_IMAGE_URL=
# 기록을 올린 뒤 채널 삭제까지 대기 시간(초)
TICKET_DELETE_DELAY_SECONDS=5
# 기록에 담을 최대 메시지 수
TRANSCRIPT_MAX_MESSAGES=5000
