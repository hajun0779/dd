# 디스코드 봇 토큰 (필수)
DISCORD_TOKEN=

# 아래 값들은 비워두면 src/config.js 의 기본값(요청받은 ID)이 사용됩니다.

# 인증 패널이 게시될 채널
VERIFY_PANEL_CHANNEL_ID=1418823709027733517
# 인증 완료 시 지급할 역할
VERIFIED_ROLE_ID=1418823708247720077

# 티켓 패널이 게시될 채널
TICKET_PANEL_CHANNEL_ID=1535140042652254219
# 티켓을 열람할 수 있는 스태프 역할
TICKET_STAFF_ROLE_ID=1535140290581635162
# 티켓 종료 시 HTML 기록이 전송될 채널
TICKET_TRANSCRIPT_CHANNEL_ID=1535140618626670623
# 티켓 채널이 생성될 카테고리
TICKET_CATEGORY_ID=1535141065160658944

# 패널 안에 배너 이미지를 넣고 싶을 때 (비워 두면 이미지 없이 나갑니다)
VERIFY_PANEL_IMAGE_URL=
TICKET_PANEL_IMAGE_URL=

# 선택 사항
# 인증 코드 유효 시간(분)
VERIFY_CODE_TTL_MINUTES=30
# 티켓 종료 후 채널 삭제까지 대기 시간(초)
TICKET_DELETE_DELAY_SECONDS=5
# 데이터 저장 경로
DATA_FILE=./data/store.json
