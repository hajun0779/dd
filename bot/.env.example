# 디스코드 봇 토큰 (필수)
# config.js 맨 위의 BOT_TOKEN 에 직접 넣어도 됩니다. 이 값이 있으면 이쪽이 우선합니다.
DISCORD_TOKEN=

# 컨테이너 맨 아래 작은 글씨에 들어갈 이름
BRAND_NAME=RoStation

# 문의 패널이 게시될 채널
TICKET_PANEL_CHANNEL_ID=1535140042652254219
# 문의를 열람할 수 있는 스태프 역할
TICKET_STAFF_ROLE_ID=1535140290581635162
# 문의를 닫을 때 HTML 기록이 올라갈 채널
TICKET_TRANSCRIPT_CHANNEL_ID=1535140618626670623

# 후기가 올라갈 채널
REVIEW_CHANNEL_ID=
# 봇이 설정과 제품 zip 파일을 보관할 채널 (스태프만 보이게 만들어 주세요)
STORAGE_CHANNEL_ID=
# 제품을 등록하고 보낼 수 있는 역할
PRODUCT_APPROVAL_ROLE_ID=

# 문의 종류마다 카테고리를 따로 씁니다.
# 제품 문의와 파트너 문의 카테고리 ID 를 비워 두면 통합 문의 카테고리를 같이 씁니다.
TICKET_CATEGORY_GENERAL=1535141065160658944
TICKET_CATEGORY_PRODUCT=
TICKET_CATEGORY_PARTNER=

# 문의 받는 시간 (한국 시간 기준)
# 이 시간 안에 올라온 문의만 스태프 역할을 부릅니다.
BUSINESS_START_HOUR=11
BUSINESS_END_HOUR=18
# 0=일 1=월 2=화 3=수 4=목 5=금 6=토
BUSINESS_DAYS=1,2,3,4,5

# 패널 안에 배너 이미지를 넣고 싶을 때 (비워 두면 이미지 없이 나갑니다)
TICKET_PANEL_IMAGE_URL=

# 선택 사항
# 기록을 올린 뒤 채널 삭제까지 대기 시간(초)
TICKET_DELETE_DELAY_SECONDS=5
# 기록에 담을 최대 메시지 수
TRANSCRIPT_MAX_MESSAGES=5000
